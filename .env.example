ANTHROPIC_API_KEY=sk-ant-...

# Validated at startup and by `install.sh -s`: the service refuses to run with a
# missing, short or placeholder value (SECURITY.md P3). Generate one with:
#   openssl rand -base64 48
SESSION_SECRET=change-this-to-a-random-64-char-string

# There is no shared password. Accounts are created from the command line:
#   cd server && npm run cli -- create-user you@example.com
# or, with a mailer configured, people can sign up and recover accounts themselves:
# SPINE_REGISTRATION=open     # default: operator. `open` refuses to start with no mailer.
# SPINE_MAILER=brevo          # default: none
# BREVO_API_KEY=
# SPINE_MAIL_SENDER="Account Notices <notices@yourdomain.com>"
# The sender and the subject are visible to the mail provider and in the recipient's
# inbox: your company or product name is fine, a more neutral one reveals less. The links in mail point at
# SPINE_DOMAIN, so that is visible too.

# Your domain, used for share link URLs
SPINE_DOMAIN=spine.yourdomain.com

# Optional. Address(es) of a reverse proxy that is NOT on this host (comma separated); loopback is always trusted. The Docker Compose
# setup sets this to its proxy. The proxy must overwrite X-Forwarded-For with the client's address (SECURITY.md S-31).
# SPINE_TRUSTED_PROXIES=

# Optional. Who runs this instance, as the privacy notice and terms name them (the controller of everyone's data) and where privacy
# requests go. Unset, they read "the operator of this instance". SPINE_LEGAL_DIR points at your own privacy.md, terms.md and purpose.md
# (see docs/legal/ and docs/compliance/); raise the versions in server/src/legal.ts when you change a text.
# SPINE_OPERATOR_NAME=
# SPINE_OPERATOR_CONTACT=
# SPINE_LEGAL_DIR=

# Optional. Where the source lives. nginx redirects /source, /docs and /security on your domain here,
# so links you publish keep working if the repository moves. Unset: those redirects are left out.
# SPINE_REPO_URL=https://github.com/you/spine

# Optional. Where "Shared securely via Spine" at the foot of a shared page leads: an https address, e.g. the product's landing page.
# Unset, the footer is text only.
# SPINE_LANDING_URL=https://spine.example.com

# Optional. Defaults to <repo>/data wherever the process is started from; both
# systemd units set it explicitly. A relative value resolves against the current
# directory, which is `server/` under npm, so prefer an absolute path.
# DATA_DIR=/var/lib/spine
PORT=3000

# Optional. Fastify binds loopback so nginx is the only public listener; only
# set this if something other than a local reverse proxy must reach it.
# SPINE_HOST=127.0.0.1

# Optional. Backups: a daily VACUUM INTO snapshot plus a mirror of
# data/originals/. The default is beside data/, which protects against
# corruption and mistakes but NOT against losing the disk — point it at
# removable or network storage, and add that path to ReadWritePaths in
# systemd/spine-backup.service.
# SPINE_BACKUP_DIR=/mnt/backup/spine
# SPINE_BACKUP_KEEP=7

# How long a sign-in lasts: unused for this many hours, or this many days after it began, whichever comes first.
# SPINE_SESSION_IDLE_HOURS=24
# SPINE_SESSION_DAYS=14
# A build checks dependencies for high or critical advisories and stops; SPINE_SKIP_AUDIT=1 skips it (offline build).

# Parsing. `text` (the default; `sidecar` is its old name) is the PDF's own text layer via the local
# Unstructured service: exact for typed PDFs, nothing for scans, and nothing leaves the host. `ocr` adds
# local Tesseract for pages with no text. `hybrid` sends only the scanned or blank pages to the LLM
# provider as images; `multimodal` sends every page.
# Sending images needs BOTH lines — choosing a parser alone is refused at startup — and
# they go to SPINE_LLM_PROVIDER, so on a deployment that must stay in the EU use Vertex
# at an eu endpoint, not Anthropic.
# SPINE_PARSER=hybrid
# SPINE_MULTIMODAL_ENABLED=true
# SPINE_LLM_MAX_TOKENS_PAGE=16384
#
# `hybrid` tries the cheapest thing first for each page: its own text layer, then local OCR
# (Tesseract), and only then the model. The model sees a page only if it has no text layer
# AND Tesseract is not confident. Needs `tesseract-ocr` and the language packs below.
# These are first guesses: watch the "page routed" lines in the log and adjust.
# SPINE_OCR=off                 # skip Tesseract: a page with no text layer goes straight to the model. Default on.
# SPINE_OCR_LANGS=ron+eng
# SPINE_OCR_MIN_CONFIDENCE=85    # mean word confidence, 0-100
# SPINE_OCR_MAX_LOW_SHARE=0.10   # share of words under 60
# SPINE_TEXT_LAYER_MIN_CHARS=50

# LLM provider. Model ids and endpoints are configuration, never code.
# Defaults are the values that used to be hardcoded, so leaving these unset
# keeps current behaviour.
# SPINE_LLM_PROVIDER=anthropic          # anthropic | vertex
# SPINE_LLM_MODEL=claude-haiku-4-5-20251001
# Models a person can pick for "Read this page with AI" and "Extract details again", besides SPINE_LLM_MODEL
# (which uploads use and which is always offered first). Comma separated, each `id` or `id=Label`. They all
# run on the same provider, endpoint, region and project as above, and each one must be processed where you
# need it (for the EU: check Google's residency table and Model Garden before adding one).
# SPINE_LLM_MODELS=claude-sonnet-5=Claude Sonnet 5,gemini-3.8-flash=Gemini 3.8 Flash
# SPINE_LLM_MAX_TOKENS_CONTINUATION=1024
# SPINE_LLM_MAX_TOKENS_EXTRACTION=16384
# The only limit on request text is the model's context window, in characters. Longer documents are split, never cut.
# SPINE_LLM_CONTEXT_CHARS=300000
# Model calls at once (pages read, page pairs checked, documents extracted). Providers rate-limit; a Pi has few cores.
# Translating a document into the reader's language sends its extracted text and the owner's notes
# to SPINE_LLM_PROVIDER, once per document and language. `off` stops it: the interface stays translated,
# the content shows in the language it was written in.
# SPINE_TRANSLATION=off
#
# Asking questions of your own records (the Ask page). On by default: each question sends your words and, for the
# documents found for it, their short summary cards, your notes and their results (not the pages) to the chat model.
# Nothing is kept on the server. Set to off to remove the page.
# SPINE_CHAT=off
#
# Looking for links between documents (a consultation and the tests it asked for, a follow-up), shown as the care chain
# on a document page. On by default: when the data points to a candidate, the short summary cards (not the pages) of the
# document and up to six others go to the chat model. Set to off to stop that; links added by hand still work.
# SPINE_LINKING=off
#
# Finding documents by what they mean, and "related documents". Off unless you set this. On, each document's short
# summary card (title, type, provider, summary, doctors, diagnoses and test names, not the pages) is sent to Vertex AI
# to be turned into numbers, and your search words too when you search by meaning. Endpoint, region and project are
# the chat model's when that is Vertex, or set them here; there is no default, because residency is the endpoint.
# `npm run cli -- check-embeddings` sends one test sentence to see that it works.
# Changing the model or the dimensions starts a new set of vectors (the old ones are removed once the new are complete).
# SPINE_EMBEDDINGS=vertex
# SPINE_EMBEDDING_MODEL=gemini-embedding-2
# SPINE_EMBEDDING_DIMS=768
# SPINE_EMBEDDING_ENDPOINT=aiplatform.eu.rep.googleapis.com
# SPINE_EMBEDDING_REGION=eu
# SPINE_EMBEDDING_PROJECT=your-project-id
# SPINE_LLM_CONCURRENCY=4

# Model calls allowed a day for the whole instance (default 5000, 0 = no ceiling). A guard rail against a leaked link or
# a loop; also set a budget alert at the provider. Raise it before a large bulk import.
# SPINE_LLM_DAILY_CALLS=5000
# SPINE_LLM_MAX_RETRIES=2
#
# Vertex AI (required for EU residency). There is deliberately NO default
# endpoint: residency is a property of the endpoint, so it must be explicit.
# Authenticate with a service account via ADC — and make sure no GOOGLE_API_KEY
# or GEMINI_API_KEY is set anywhere in the environment, because the service
# refuses to start if one is, see SECURITY.md M-8.
# SPINE_LLM_PROVIDER=vertex
# SPINE_LLM_MODEL=gemini-3.8-flash
# SPINE_LLM_ENDPOINT=aiplatform.eu.rep.googleapis.com
# SPINE_LLM_REGION=eu
# SPINE_LLM_PROJECT=your-gcp-project
# GOOGLE_APPLICATION_CREDENTIALS=/etc/spine/vertex-sa.json

# What one account may keep in its vault, in MB: all of it, and one sealed object (docs/crypto-design.md)
# SPINE_VAULT_MAX_MB=5120
# SPINE_VAULT_MAX_OBJECT_MB=100

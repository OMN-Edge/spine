{
  "name": "spine-core",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:accounts": "vitest run -c vitest.accounts.config.ts",
    "test:shim": "vitest run -c vitest.shim.config.ts",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@langchain/core": "^1.2.17",
    "@langchain/langgraph": "^1.5.1",
    "heic-convert": "^2.1.0",
    "pdfjs-dist": "^6.4.299",
    "uuid": "^14.0.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/pdfkit": "^0.17.7",
    "@vitest/coverage-v8": "^5.0.5",
    "better-sqlite3": "^13.0.3",
    "pdfkit": "^0.20.2",
    "sharp": "^0.35.5",
    "typescript": "^5.5.0",
    "vitest": "^5.0.5"
  }
}

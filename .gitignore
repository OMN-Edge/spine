.env
relay.env
.env.*
!.env.example
relay.env.*
!relay.env.example
node_modules/
dist/
coverage/
# Everything the server keeps (the accounts database, the vault, sealed shares, the country file, backups) stays out; only the directory is tracked.
data/*
!data/.gitkeep
relay-data/
__pycache__/
*.pyc
.venv/

# tsc emits .js next to the .tsx sources; Vite resolves .js before .ts,
# so these would shadow the real sources. See web/tsconfig.json noEmit.
web/src/**/*.js

# Local credentials (service account keys). Never commit.
secrets/
*-sa.json
project-*.json

# Scratch comparisons of model readings: real records, never committed.
compare*.txt

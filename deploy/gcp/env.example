# The server's .env for spinevault.eu on one Compute Engine VM (docs/deploy-gcp.md). Copy to .env on the VM and fill in what says CHANGE.
# Nothing here is a secret until you fill it in: keep the filled file out of git (.env is ignored) and out of chats and logs.

# openssl rand -base64 48
SESSION_SECRET=CHANGE
SPINE_DOMAIN=spinevault.eu

# Where the privacy notice and terms say to write to the operator (the company they name is the seller saved on /admin/invoices)
SPINE_OPERATOR_CONTACT=privacy@spinevault.eu
# SPINE_OPERATOR_SECURITY_CONTACT=CHANGE   # the Contact: of /.well-known/security.txt, when that is not the contact above
# SPINE_OPERATOR_PRIVACY_CONTACT=CHANGE   # where requests about a person's data go (the privacy notice), when that is not the contact above
SPINE_REPO_URL=https://github.com/OMN-Edge/spine

# Mail: a Brevo sender on spinevault.eu (SPF, DKIM and DMARC set), the API key and not the SMTP key. Open sign-up refuses to start without a mailer.
SPINE_MAILER=brevo
BREVO_API_KEY=CHANGE
SPINE_MAIL_SENDER="Account Notices <notices@spinevault.eu>"
SPINE_REGISTRATION=open
# Accounts (already signed up and confirmed) that may approve others and that cost and ceiling alerts go to
SPINE_ADMIN_EMAILS=CHANGE
SPINE_ALERT_EMAIL=CHANGE

# Family's 25 GB is unreachable below this
SPINE_VAULT_MAX_MB=25600

# The relay runs on this machine, at its own name (docs/relay.md); its provider settings are in relay.env
SPINE_RELAY_DOMAIN=relay.spinevault.eu
SPINE_RELAY_URL=https://relay.spinevault.eu
COMPOSE_PROFILES=relay
# openssl rand -base64 48
SPINE_RELAY_SECRET=CHANGE

# Models: the ones the relay may call, and the features that send short text to them (SECURITY.md M-15, M-16, M-18)
SPINE_LLM_MODEL=gemini-3.5-flash
SPINE_LLM_MODELS=gemini-3.7-flash=Gemini 3.7 Flash,gemini-3.5-flash=Gemini 3.5 Flash
SPINE_LLM_MAX_TOKENS_CONTINUATION=1024
SPINE_LLM_CONCURRENCY=4
SPINE_LLM_MAX_RETRIES=6
SPINE_PARSER=hybrid
SPINE_OCR=off
SPINE_MULTIMODAL_ENABLED=true
SPINE_EMBEDDINGS=vertex
SPINE_CHAT=on
SPINE_LINKING=on
SPINE_CHAT_AGENT=on

# Plans and payment (docs/billing.md). Leave off until the Stripe sandbox is set up, then fill every line in; sandbox first.
# SPINE_BILLING=on
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# SPINE_STRIPE_PRICE_YEAR=price_
# SPINE_STRIPE_PRICE_MONTH=price_
# SPINE_STRIPE_PRICE_FOUNDING=price_
# SPINE_STRIPE_PRICE_FAMILY_YEAR=price_
# SPINE_STRIPE_PRICE_FAMILY_MONTH=price_

# How many daily snapshots the backup service keeps in the backups volume; docs/deploy-gcp.md copies them off the machine
SPINE_BACKUP_KEEP=14

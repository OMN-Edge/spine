# The relay's own settings for spinevault.eu on a Compute Engine VM (docs/deploy-gcp.md). Copy to relay.env beside .env.
# No key file and no API key: the relay calls Vertex as the VM's service account (Application Default Credentials), and refuses to start if
# GOOGLE_API_KEY or GEMINI_API_KEY is set (SECURITY.md M-8). Residency is the endpoint (docs/deployment-gcp.md).
SPINE_LLM_PROVIDER=vertex
SPINE_LLM_ENDPOINT=aiplatform.eu.rep.googleapis.com
SPINE_LLM_REGION=eu
# CHANGE: the id of the Google Cloud project the VM is in
SPINE_LLM_PROJECT=CHANGE

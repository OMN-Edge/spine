# The public listener of the Docker Compose setup: TLS from Let's Encrypt, and the same headers as nginx/spine.conf.
# SPINE_DOMAIN and SPINE_RELAY_DOMAIN come from .env through compose.yaml. The relay's name is a second address of this site, and empty
# when the relay runs elsewhere; a site address cannot be empty, so it is not a block of its own.
{$SPINE_DOMAIN} {$SPINE_RELAY_DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 200MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "accelerometer=(), camera=(self), display-capture=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' blob:; font-src 'self'; connect-src 'self' {$SPINE_RELAY_URL:}; object-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
		-Server
	}

	@share path /share/*
	header @share {
		X-Robots-Tag "noindex, nofollow"
		Cache-Control "no-store"
	}

	@dotfiles {
		path_regexp \/\.
		not path /.well-known/*
	}

	# The relay (docs/relay.md), when it runs here. It answers its own CORS, and streams chat replies.
	# An expression, not `host`: Compose passes an empty name when there is no relay here, and a `host` matcher with none stops Caddy.
	@relay expression `"{$SPINE_RELAY_DOMAIN}" != "" && {host} == "{$SPINE_RELAY_DOMAIN}"`
	handle @relay {
		reverse_proxy relay:8080 {
			flush_interval -1
			transport http {
				response_header_timeout 300s
				read_timeout 300s
			}
		}
	}

	handle {
		respond @dotfiles 403

		# Caddy replaces X-Forwarded-For with the client's address, which is what SPINE_TRUSTED_PROXIES relies on (SECURITY.md S-31).
		reverse_proxy web:3000 {
			flush_interval -1
			transport http {
				response_header_timeout 300s
				read_timeout 300s
			}
		}
	}
}

{
  "name": "spine-server",
  "version": "1.0.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc && cp src/store/sqlite/schema.sql dist/store/sqlite/schema.sql",
    "start": "node dist/index.js",
    "dev": "tsx watch --env-file=../.env src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:shim": "vitest run -c vitest.shim.config.ts",
    "test:coverage": "vitest run --coverage",
    "cli": "node --env-file=../.env dist/cli.js",
    "test:integration": "SPINE_INTEGRATION=1 vitest run -c vitest.integration.config.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/multipart": "^10.1.4",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/session": "^11.1.4",
    "@fastify/static": "^10.1.6",
    "@ip-location-db/dbip-country-mmdb": "^2.3.2026060120",
    "@langchain/anthropic": "^1.5.12",
    "@langchain/core": "^1.2.17",
    "@langchain/google-vertexai": "^2.3.2",
    "@langchain/langgraph": "^1.5.1",
    "@node-rs/argon2": "^2.2.2",
    "@simplewebauthn/server": "^14.0.3",
    "better-sqlite3": "^13.0.3",
    "dejavu-fonts-ttf": "^2.37.3",
    "fastify": "^5.12.7",
    "google-auth-library": "^11.3.1",
    "heic-convert": "^2.1.0",
    "maxmind": "^5.0.7",
    "pdfjs-dist": "^6.4.299",
    "pdfkit": "^0.20.2",
    "sharp": "^0.35.5",
    "uuid": "^14.0.3",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20.14.0",
    "@types/pdfkit": "^0.17.7",
    "@types/uuid": "^10.0.0",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitest/coverage-v8": "^2.0.0",
    "tsx": "^4.15.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}

{
  "name": "spine-server",
  "version": "1.0.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch --env-file=../.env src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:accounts": "vitest run -c vitest.accounts.config.ts",
    "test:shim": "vitest run -c vitest.shim.config.ts",
    "test:coverage": "vitest run --coverage",
    "cli": "node --env-file=../.env dist/cli.js",
    "test:integration": "SPINE_INTEGRATION=1 vitest run -c vitest.integration.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "spine-core": "*",
    "@fastify/cookie": "^11.1.3",
    "@fastify/multipart": "^10.1.4",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/session": "^11.1.4",
    "@fastify/static": "^10.1.6",
    "@langchain/core": "^1.2.17",
    "@node-rs/argon2": "^2.2.2",
    "@simplewebauthn/server": "^14.0.3",
    "fastify": "^5.12.7",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20.14.0",
    "@types/uuid": "^10.0.0",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitest/coverage-v8": "^2.0.0",
    "better-sqlite3": "^13.0.3",
    "pdfkit": "^0.20.2",
    "sharp": "^0.35.5",
    "tsx": "^4.15.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  }
}

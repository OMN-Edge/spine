{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "types": [
      "node"
    ],
    "typeRoots": [
      "../node_modules/@types",
      "./node_modules/@types"
    ],
    "skipLibCheck": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable",
      "WebWorker"
    ],
    "paths": {
      "spine-core/*": [
        "../core/src/*"
      ],
      "pdfjs-real/*": [
        "./node_modules/pdfjs-dist/*",
        "../node_modules/pdfjs-dist/*"
      ]
    }
  },
  "include": [
    "src/core/**/*.ts",
    "src/build/**/*.ts",
    "../core/src/**/*.ts"
  ],
  "exclude": [
    "../core/src/__tests__",
    "../core/src/testing",
    "../core/src/**/*.test.ts",
    "src/e2e",
    "src/core/llm.test.ts"
  ]
}
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && tsc -p tsconfig.core.json && vite build && node scripts/check-bundle.mjs",
    "preview": "vite preview",
    "test": "vitest run --exclude \"src/core/**\" && vitest run -c vitest.core.config.mjs && vitest run -c vitest.relay.config.mjs",
    "check:browser": "node browser-check/run.mjs",
    "check:app": "node browser-check/app.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@simplewebauthn/browser": "^14.0.0",
    "@sqlite.org/sqlite-wasm": "^3.54.1-build1",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/ron": "^1.0.0",
    "dejavu-fonts-ttf": "^2.37.3",
    "fflate": "^0.8.3",
    "libsodium-wrappers-sumo": "^0.8.4",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "qrcode": "^1.5.4",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^7.18.4",
    "scanic": "^1.7.1",
    "spine-core": "*",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/libsodium-wrappers-sumo": "^0.7.8",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",

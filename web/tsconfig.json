{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/e2e",
    "src/core/boot.ts",
    "src/core/boot.test.ts",
    "src/core/persist.test.ts",
    "src/core/llm.test.ts",
    "src/core/native",
    "src/core/boot-share.ts",
    "src/core/share/host.ts",
    "src/core/core.worker.ts"
  ]
}

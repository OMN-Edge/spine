{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "spine-core/*": [
        "../core/src/*"
      ],
      "pdfjs-real/*": [
        "./node_modules/pdfjs-dist/*",
        "../node_modules/pdfjs-dist/*"
      ]
    }
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/e2e",
    "src/core/boot.ts",
    "src/core/device-store.ts",
    "src/core/boot.test.ts",
    "src/core/persist.test.ts",
    "src/core/client.test.ts",
    "src/core/native-tools.test.ts",
    "src/build",
    "src/core/llm.test.ts",
    "src/core/native",
    "src/core/boot-share.ts",
    "src/core/share/host.ts",
    "src/core/core.worker.ts"
  ]
}

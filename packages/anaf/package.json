{
  "name": "spine-anaf",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "description": "The link to ANAF: the OAuth authorisation, e-Factura (the XML, the numbering, the upload, the answer, the PDF) and the checks around them. Names nothing of Spine's.",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "dejavu-fonts-ttf": "^2.37.3",
    "pdfkit": "^0.20.2"
  },
  "devDependencies": {
    "@types/pdfkit": "^0.17.7",
    "@types/node": "^22.20.5",
    "typescript": "^5.5.0",
    "vitest": "^5.0.5"
  }
}

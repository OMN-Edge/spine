[Unit]
Description=Spine — back up the database and originals
After=network-online.target

[Service]
Type=oneshot
User=SPINE_USER
WorkingDirectory=SPINE_DIR/server
ExecStart=/usr/bin/node SPINE_DIR/server/dist/backup.js
EnvironmentFile=SPINE_DIR/.env
Environment=NODE_ENV=production
Environment=DATA_DIR=SPINE_DIR/data
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
# Needs the archive to read and the backup target to write. Point
# SPINE_BACKUP_DIR at removable or network storage to survive losing the SD
# card, and add that path here — ProtectSystem=strict makes it read-only
# otherwise.
ReadWritePaths=SPINE_DIR/data SPINE_DIR/backups

[Install]
WantedBy=multi-user.target

[Unit]
Description=Spine — relay for model calls (docs/relay.md)
After=network-online.target
Wants=network-online.target
# The repository may be on a disk mounted at boot (a USB drive): start once it is there
RequiresMountsFor=SPINE_DIR

[Service]
Type=simple
User=SPINE_USER
WorkingDirectory=SPINE_DIR/server
ExecStart=/usr/bin/node SPINE_DIR/server/dist/relay/main.js
# The settings it shares with the server (the relay secret, the models), then the provider's credential, which the server never reads
EnvironmentFile=SPINE_DIR/.env
EnvironmentFile=SPINE_DIR/relay.env
# The server's secrets are not the relay's to hold; this applies after both files
UnsetEnvironment=SESSION_SECRET BREVO_API_KEY PADDLE_API_KEY PADDLE_WEBHOOK_SECRET STRIPE_SECRET_KEY STRIPE_WEBHOOK_SECRET BILLYOU_API_KEY
Environment=NODE_ENV=production
# Loopback only, behind nginx; not PORT, which is the server's. The port is SPINE_RELAY_PORT in .env (default 8080), written by install.sh -r
Environment=SPINE_RELAY_HOST=127.0.0.1
Environment=SPINE_RELAY_PORT=RELAY_PORT_HERE
Environment=SPINE_RELAY_ORIGIN=https://SPINE_DOMAIN
# The server's own database: with plans on the relay asks it what each account may do and counts the day's calls in it, and an account it
# does not hold is refused (SECURITY.md S-64). Both processes are one user on one disk, which SQLite in WAL mode shares. install.sh -r writes
# the server's data/ here, or, with SPINE_STORE=postgres (a database reached over the network, so no file is shared), a directory of its own.
Environment=DATA_DIR=RELAY_DATA_HERE
Environment=SPINE_DB_PATH=RELAY_DATA_HERE/spine.db
Restart=on-failure
RestartSec=5s
# What it makes is readable by its own user alone (SECURITY.md S-61)
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
# The database's directory: SQLite writes its -wal and -shm files beside it
ReadWritePaths=RELAY_DATA_HERE
PrivateTmp=true

[Install]
WantedBy=multi-user.target

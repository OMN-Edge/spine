[Unit]
Description=Spine — relay for model calls (docs/relay.md)
After=network-online.target
Wants=network-online.target
# The repository may be on a disk mounted at boot (a USB drive): start once it is there
RequiresMountsFor=SPINE_DIR

[Service]
Type=simple
User=SPINE_USER
WorkingDirectory=SPINE_DIR/server
ExecStart=/usr/bin/node SPINE_DIR/server/dist/relay/main.js
# The settings it shares with the server (the relay secret, the models), then the provider's credential, which the server never reads
EnvironmentFile=SPINE_DIR/.env
EnvironmentFile=SPINE_DIR/relay.env
# The server's secrets are not the relay's to hold; this applies after both files
UnsetEnvironment=SESSION_SECRET BREVO_API_KEY
Environment=NODE_ENV=production
# Loopback only, behind nginx; not PORT, which is the server's
Environment=SPINE_RELAY_HOST=127.0.0.1
Environment=SPINE_RELAY_PORT=8080
Environment=SPINE_RELAY_ORIGIN=https://SPINE_DOMAIN
# The daily count, kept across restarts
Environment=SPINE_DB_PATH=SPINE_DIR/relay-data/relay.db
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=SPINE_DIR/relay-data
PrivateTmp=true

[Install]
WantedBy=multi-user.target

[Unit]
Description=Spine — medical document server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=SPINE_USER
WorkingDirectory=SPINE_DIR/server
ExecStart=/usr/bin/node SPINE_DIR/server/dist/index.js
EnvironmentFile=SPINE_DIR/.env
Environment=NODE_ENV=production
Environment=DATA_DIR=SPINE_DIR/data
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=SPINE_DIR/data
PrivateTmp=true

[Install]
WantedBy=multi-user.target

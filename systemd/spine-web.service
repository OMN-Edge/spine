[Unit]
Description=Spine — medical document server
After=network-online.target
Wants=network-online.target
# The repository and the backup may be on disks mounted at boot (a USB drive, another card): start once both are there
RequiresMountsFor=SPINE_DIR SPINE_BACKUP_TARGET

[Service]
Type=simple
User=SPINE_USER
WorkingDirectory=SPINE_DIR/server
ExecStart=/usr/bin/node SPINE_DIR/server/dist/index.js
EnvironmentFile=SPINE_DIR/.env
Environment=NODE_ENV=production
Environment=DATA_DIR=SPINE_DIR/data
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
# The archive, and the backup (SPINE_BACKUP_DIR, written in by install.sh -s): deleting an account removes the backup's copy of its vault,
# which with ProtectSystem=strict and a backup on another path was read-only, and the deletion failed
ReadWritePaths=SPINE_DIR/data SPINE_BACKUP_TARGET
PrivateTmp=true

[Install]
WantedBy=multi-user.target
